{% extends "layouts/admin.twig" %}

{% block title %}Users | MarwaPHP Admin{% endblock %}

{% block content %}
  {% set button_base = 'inline-flex items-center justify-center gap-2 rounded-xl border px-3.5 py-2 text-[0.82rem] font-semibold transition' %}
  {% set button_primary = button_base ~ ' border-transparent bg-app-accent text-white hover:bg-app-accent-soft' %}
  <section class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <span class="inline-flex w-fit items-center rounded-xl border border-app-accent/20 bg-app-accent/10 px-3 py-1 text-[0.65rem] font-extrabold uppercase tracking-[0.16em] text-app-accent">Identity management</span>

    <div class="flex flex-wrap gap-2">
      {% if gate.allows('users.create') %}
        <a class="{{ button_primary }} users-create-button" href="/admin/users/create">Create user</a>
      {% endif %}
    </div>
  </section>

  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {% include '@Shared/components/card.twig' with {variant: 'stat', label: 'Total Users', value: stats.total, meta: 'Registered accounts', value_class: 'font-mono text-2xl font-bold tabular-nums text-app-accent'} only %}
    {% include '@Shared/components/card.twig' with {variant: 'stat', label: 'Active', value: stats.active, meta: (stats.total > 0 ? ((stats.active / stats.total) * 100)|round(1) : 0) ~ '% of total', value_class: 'font-mono text-2xl font-bold tabular-nums text-app-success'} only %}
    {% include '@Shared/components/card.twig' with {variant: 'stat', label: 'Disabled', value: stats.disabled, meta: (stats.total > 0 ? ((stats.disabled / stats.total) * 100)|round(1) : 0) ~ '% of total', value_class: 'font-mono text-2xl font-bold tabular-nums text-app-warning'} only %}
    {% include '@Shared/components/card.twig' with {variant: 'stat', label: 'Trashed', value: stats.trashed, meta: 'Soft-deleted accounts', value_class: 'font-mono text-2xl font-bold tabular-nums text-app-danger'} only %}
  </div>

  {% include '@Shared/components/data-table.twig' with { table: table } only %}
{% endblock %}
