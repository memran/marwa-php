{% extends "layouts/admin.twig" %}

{% block title %}Create API Token | MarwaPHP Admin{% endblock %}

{% block content %}
  <section class="space-y-6">
    <header>
      <a href="/admin/api-tokens" class="inline-flex items-center gap-2 text-sm font-semibold text-app-muted transition hover:text-app-text">
        {% include '@Shared/components/icon.twig' with { name: 'arrow-left', class: 'h-4 w-4' } only %}
        <span>Back to API tokens</span>
      </a>
      <h1 class="mt-3 text-2xl font-bold tracking-tight text-app-text">Create API Token</h1>
      <p class="mt-1 text-sm text-app-muted">Generate a scoped token for external service access.</p>
    </header>

    <div class="max-w-3xl">
      {% include '@Shared/components/form.twig' with {
        form: form,
        action: '/admin/api-tokens',
        title: 'Token details',
        description: 'Set request limits and optional network restrictions.',
        submit_label: 'Create token',
        submit_icon: 'plus',
        cancel_url: '/admin/api-tokens'
      } only %}
    </div>
  </section>
{% endblock %}
