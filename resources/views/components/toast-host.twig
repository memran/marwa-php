{% set toasts = toasts|default([]) %}

<div
  class="fixed bottom-4 right-4 z-50 grid w-[min(24rem,calc(100vw-2rem))] gap-3"
  aria-live="polite"
  aria-atomic="false"
  data-toast-host
>
  {% for toast in toasts %}
    {% include '@Shared/components/toast.twig' with { toast: toast } only %}
  {% endfor %}

  <template data-toast-template>
    {% include '@Shared/components/toast.twig' with {
      toast: {
        tone: 'info',
        title: '',
        message: '',
        duration: 6000
      }
    } only %}
  </template>
</div>
