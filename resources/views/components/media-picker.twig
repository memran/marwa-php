{% set id = id|default(name|default('media-picker')) %}
{% set name = name|default(id) %}
{% set label = label|default('Media') %}
{% set value = value|default('') %}
{% set help = help|default('Select existing media, enter a public URL, or upload a new file.') %}
{% set error = error|default('') %}
{% set items = items|default([]) %}
{% set allow_url = allow_url is defined ? allow_url : true %}
{% set allow_clear = allow_clear is defined ? allow_clear : not required|default(false) %}
{% set required = required|default(false) %}
{% set disabled = disabled|default(false) %}
{% set current_name = current_name|default('') %}
{% set current_preview_url = current_preview_url|default(value) %}
{% set upload_name = upload_name|default('') %}
{% set upload_label = upload_label|default('Upload new media') %}
{% set upload_help = upload_help|default('Choose an image from your device.') %}
{% set upload_accept = upload_accept|default('image/avif,image/jpeg,image/png,image/webp,image/gif,image/svg+xml') %}
{% set upload_max_bytes = upload_max_bytes|default(null) %}
{% set remove_name = remove_name|default('') %}
{% set remove_label = remove_label|default('Remove current media') %}
{% set empty_message = empty_message|default('No existing media is available.') %}
{% set wrapper_class = wrapper_class|default('') %}
{% set selected_name = current_name %}

{% if not selected_name and value %}
  {% for item in items %}
    {% if item.value|default(item.url|default('')) == value %}
      {% set selected_name = item.name|default(item.label|default('Selected media')) %}
    {% endif %}
  {% endfor %}
{% endif %}

<div class="grid gap-3 {{ wrapper_class }}" data-media-picker>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      {% if label %}
        <label class="text-sm font-semibold text-app-text" for="{{ id }}">
          {{ label }}{% if required %} <span class="text-app-danger" aria-hidden="true">*</span>{% endif %}
        </label>
      {% endif %}
      {% if help %}<p id="{{ id }}-help" class="mt-1 text-xs leading-5 text-app-muted">{{ help }}</p>{% endif %}
    </div>
    {% if allow_clear %}
      <button class="{{ value ? 'inline-flex' : 'hidden' }} h-8 items-center gap-1.5 rounded-md px-2.5 text-xs font-semibold text-app-muted transition hover:bg-app-surface-2 hover:text-app-text" type="button" data-media-picker-clear>
        {% include '@Shared/components/icon.twig' with { name: 'x', class: 'h-3.5 w-3.5' } only %}
        <span>Clear</span>
      </button>
    {% endif %}
  </div>

  {% if allow_url %}
    <div class="grid gap-1.5">
      <label class="text-xs font-semibold text-app-muted" for="{{ id }}">Public URL or path</label>
      <input
        class="h-10 w-full rounded-lg border border-app-border bg-app-surface px-3 text-sm text-app-text outline-none transition placeholder:text-app-muted focus:border-app-accent focus:ring-2 focus:ring-app-accent/20"
        id="{{ id }}"
        name="{{ name }}"
        type="text"
        inputmode="url"
        value="{{ value }}"
        placeholder="https://example.com/image.jpg or /uploads/image.jpg"
        data-media-picker-value
        {% if required %}required aria-required="true"{% endif %}
        {% if disabled %}disabled{% endif %}
        {% if help or error %}aria-describedby="{{ help ? id ~ '-help' : '' }}{{ help and error ? ' ' : '' }}{{ error ? id ~ '-error' : '' }}"{% endif %}
        {% if error %}aria-invalid="true"{% endif %}
      >
    </div>
  {% else %}
    <input id="{{ id }}" name="{{ name }}" type="hidden" value="{{ value }}" data-media-picker-value>
  {% endif %}

  <div class="{{ value ? 'flex' : 'hidden' }} min-w-0 items-center gap-3 rounded-lg border border-app-accent/20 bg-app-accent/5 p-3" data-media-picker-selection aria-live="polite">
    <img class="{{ current_preview_url ? '' : 'hidden' }} h-16 w-20 shrink-0 rounded-md border border-app-border bg-app-surface object-cover" src="{{ current_preview_url }}" alt="" data-media-picker-preview>
    <span class="{{ current_preview_url ? 'hidden' : 'inline-flex' }} h-10 w-10 shrink-0 items-center justify-center rounded-md bg-app-accent/10 text-app-accent" data-media-picker-icon aria-hidden="true">
      {% include '@Shared/components/icon.twig' with { name: 'image', class: 'h-5 w-5' } only %}
    </span>
    <div class="min-w-0">
      <p class="text-xs font-semibold text-app-muted">Selected media</p>
      <p class="truncate text-sm font-semibold text-app-text" data-media-picker-name>{{ selected_name|default(value) }}</p>
      <p class="mt-0.5 truncate text-xs text-app-muted" data-media-picker-path>{{ value }}</p>
      {% if remove_name %}
        <button class="mt-2 inline-flex items-center gap-1.5 rounded-md border border-app-danger/20 bg-app-danger/10 px-2.5 py-1 text-xs font-semibold text-app-danger transition hover:bg-app-danger/15" type="submit" name="{{ remove_name }}" value="1">
          {% include '@Shared/components/icon.twig' with { name: 'trash-2', class: 'h-3.5 w-3.5' } only %}
          <span>{{ remove_label }}</span>
        </button>
      {% endif %}
    </div>
  </div>

  {% if items is not empty %}
    <section class="grid gap-3" aria-labelledby="{{ id }}-library-label">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <h3 id="{{ id }}-library-label" class="text-xs font-bold uppercase tracking-wide text-app-muted">Media library</h3>
        {% if items|length > 6 %}
          <label class="relative block sm:w-64">
            <span class="sr-only">Search media</span>
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-app-muted" aria-hidden="true">
              {% include '@Shared/components/icon.twig' with { name: 'search', class: 'h-4 w-4' } only %}
            </span>
            <input class="h-9 w-full rounded-lg border border-app-border bg-app-surface pl-9 pr-3 text-sm text-app-text outline-none focus:border-app-accent focus:ring-2 focus:ring-app-accent/20" type="search" placeholder="Search media..." data-media-picker-search>
          </label>
        {% endif %}
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4" role="group" aria-label="Available media" data-media-picker-library>
        {% for item in items %}
          {% set item_kind = item.kind|default(item.type|default('image')) %}
          {% set item_source = item.url|default('') %}
          {% set item_value = item.value|default(item_source) %}
          {% set item_url = item.preview_url|default(item.thumbnail_url|default(item_kind == 'image' ? item_source|default(item_value) : '')) %}
          {% set item_name = item.name|default(item.label|default('Media ' ~ loop.index)) %}
          {% set is_selected = item_value == value %}
          <button
            class="group overflow-hidden rounded-lg border text-left transition focus:outline-none focus:ring-2 focus:ring-app-accent/30 {{ is_selected ? 'border-app-accent bg-app-accent/5' : 'border-app-border bg-app-surface hover:border-app-accent/40' }}"
            type="button"
            data-media-picker-item
            data-media-value="{{ item_value }}"
            data-media-url="{{ item_url }}"
            data-media-name="{{ item_name }}"
            data-media-search="{{ item_name|lower }} {{ item_value|lower }}"
            aria-pressed="{{ is_selected ? 'true' : 'false' }}"
          >
            <span class="flex aspect-video items-center justify-center overflow-hidden bg-app-surface-2" aria-hidden="true">
              {% if item_url %}
                <img class="h-full w-full object-cover transition group-hover:scale-105" src="{{ item_url }}" alt="" loading="lazy">
              {% else %}
                {% include '@Shared/components/icon.twig' with { name: item_kind == 'video' ? 'video' : 'file', class: 'h-6 w-6 text-app-muted' } only %}
              {% endif %}
            </span>
            <span class="block truncate px-3 py-2 text-xs font-semibold text-app-text">{{ item_name }}</span>
          </button>
        {% endfor %}
      </div>
      <div class="hidden" data-media-picker-empty>
        {% include '@Shared/components/empty-state.twig' with {
          state: {
            title: empty_message,
            icon: 'images',
            size: 'compact',
            surface: 'dashed'
          }
        } only %}
      </div>
    </section>
  {% endif %}

  {% if upload_name %}
    {% include '@Shared/components/file-upload.twig' with {
      id: id ~ '-upload',
      name: upload_name,
      label: upload_label,
      help: upload_help,
      accept: upload_accept,
      max_bytes: upload_max_bytes,
      preview_images: true,
      disabled: disabled
    } only %}
  {% endif %}

  {% if error %}<p id="{{ id }}-error" class="text-sm text-app-danger">{{ error }}</p>{% endif %}
</div>
