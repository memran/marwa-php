{% set modal_id = modal_id|default('shared-modal') %}
{% set title = title|default('Confirm action') %}
{% set description = description|default('') %}
{% set trigger_label = trigger_label|default('Open') %}
{% set trigger_icon = trigger_icon|default('') %}
{% set tone = tone|default('neutral') %}
{% set size = size|default('md') %}
{% set cancel_label = cancel_label|default('Cancel') %}
{% set trigger_class = trigger_class|default(
  tone == 'danger'
    ? 'border-app-danger/20 text-app-danger hover:bg-app-danger/10'
    : 'border-app-border text-app-text hover:bg-app-surface-2'
) %}
{% set panel_size = size == 'sm'
  ? 'max-w-md'
  : (size == 'lg' ? 'max-w-3xl' : 'max-w-xl') %}

<div class="inline-flex" {{ ui().data({ modal: true }) }}>
  <button
    class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border px-4 text-sm font-semibold transition {{ trigger_class }}"
    type="button"
    aria-haspopup="dialog"
    aria-controls="{{ modal_id }}"
    {{ ui().on('click', '$refs.dialog.showModal()') }}
  >
    {% if trigger_icon %}
      {% include '@Shared/components/icon.twig' with { name: trigger_icon, class: 'h-4 w-4' } only %}
    {% endif %}
    <span>{{ trigger_label }}</span>
  </button>

  <dialog
    id="{{ modal_id }}"
    class="m-auto w-[calc(100%-2rem)] {{ panel_size }} overflow-hidden rounded-xl border border-app-border bg-app-surface p-0 text-app-text shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm"
    aria-labelledby="{{ modal_id }}-title"
    {% if description %}aria-describedby="{{ modal_id }}-description"{% endif %}
    {{ ui().ref('dialog') }}
    {{ ui().on('click', 'if ($event.target === $refs.dialog) $refs.dialog.close()') }}
  >
    <header class="flex items-start justify-between gap-4 border-b border-app-border px-5 py-4">
      <div class="min-w-0">
        <h2 id="{{ modal_id }}-title" class="text-base font-bold {% if tone == 'danger' %}text-app-danger{% else %}text-app-text{% endif %}">{{ title }}</h2>
        {% if description %}
          <p id="{{ modal_id }}-description" class="mt-1 text-sm leading-6 text-app-muted">{{ description }}</p>
        {% endif %}
      </div>
      <form method="dialog">
        <button class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-app-muted transition hover:bg-app-surface-2 hover:text-app-text" type="submit" aria-label="Close dialog" title="Close">
          {% include '@Shared/components/icon.twig' with { name: 'x', class: 'h-4 w-4' } only %}
        </button>
      </form>
    </header>

    <div class="px-5 py-4">
      {% block body %}{% endblock %}
    </div>

    <footer class="flex flex-wrap items-center justify-end gap-3 border-t border-app-border bg-app-surface-2/50 px-5 py-4">
      <form method="dialog">
        <button class="inline-flex h-10 items-center justify-center rounded-lg border border-app-border bg-app-surface px-4 text-sm font-semibold text-app-text transition hover:bg-app-surface-2" type="submit">
          {{ cancel_label }}
        </button>
      </form>
      {% block actions %}{% endblock %}
    </footer>
  </dialog>
</div>
